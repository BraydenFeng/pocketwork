# Copy to .env (or .env.local) and fill in from your Supabase project: Settings → API.
# Only NEXT_PUBLIC_ keys go into the browser. The server-only keys below belong in Vercel's encrypted environment, never source control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED=false
# Leave false until the compatible phone release is available to syncing users.
NEXT_PUBLIC_NATIVE_FORMAT4_ENABLED=false

SITE_URL=
PUBLIC_PUBLISHER_NAME=
PUBLIC_SUPPORT_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign in with Apple Services ID used by Supabase; ISSUER_ID is the Apple Team ID.
# Add SITE_URL/api/account/apple-callback as an Apple return URL.
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_ISSUER_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=

# App Store Connect In-App Purchase API key. ISSUER_ID is its issuer UUID.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_BUNDLE_ID=com.braydenfeng.pocketwork
APP_STORE_PRODUCT_ID=com.braydenfeng.pocketwork.pro.monthly
APP_STORE_ENVIRONMENT=Production
